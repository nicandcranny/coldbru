meta {
  name: hasCookie
  type: http
  seq: 10
}

get {
  url: {{host}}/ping
  body: none
  auth: inherit
}

script:pre-request {
  const jar = bru.cookies.jar()

  jar.setCookie("http://localhost:8081", "existing_cookie", "some_value")
}

tests {
  const jar = bru.cookies.jar()

  test("should return true for a cookie that exists", async function() {
    const exists = await jar.hasCookie('http://localhost:8081', 'existing_cookie');
    expect(exists).to.be.true;
  });

  test("should return false for a cookie that does not exist", async function() {
    const exists = await jar.hasCookie('http://localhost:8081', 'nonexistent_cookie');
    expect(exists).to.be.false;
  });

  jar.hasCookie("http://localhost:8081", "existing_cookie", function(error, exists) {
    test("should work with callback pattern", function() {
      expect(error).to.be.null;
      expect(exists).to.be.true;
    });
  });

  jar.clear()
}

settings {
  encodeUrl: true
}
